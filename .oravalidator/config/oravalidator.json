{
  "_comentario": "Configuración del validador PL/SQL. Los umbrales replican la hoja 'Configuración' de la matriz. Edita este archivo en el repo (.oravalidator/config/oravalidator.json) para ajustar la política del equipo.",
  "extensiones": [
    ".sql",
    ".pks",
    ".pkb",
    ".pck",
    ".pkg",
    ".prc",
    ".fnc",
    ".trg",
    ".vw",
    ".tps",
    ".tpb",
    ".pls",
    ".plb",
    ".ddl",
    ".tab",
    ".seq",
    ".idx",
    ".con",
    ".typ"
  ],
  "excluir_rutas": [
    "**/test/**/datos/**",
    "**/node_modules/**",
    "**/.oravalidator/**"
  ],
  "umbrales": {
    "MaxLineLength": 140,
    "MaxProcedureLines": 500,
    "MaxFunctionLines": 300,
    "MaxPackageLines": 3000,
    "MaxTriggerLines": 150,
    "MaxBlockLines": 1500,
    "MaxNestingDepth": 4,
    "MaxCyclomaticComplexity": 10,
    "MaxCaseWhen": 15,
    "MaxBlankLines": 2,
    "MinIdentifierLength": 3,
    "MaxIdentifierLength": 30,
    "MaxLocalVarchar2": 4000,
    "DuplicateBlockLines": 6,
    "DuplicateBlockRepeats": 3
  },
  "quality_gate": {
    "_comentario": "Máximo de hallazgos permitidos por severidad antes de bloquear el push. 0 = cualquier hallazgo bloquea; null = nunca bloquea. FailOnMajor es 'configurable' en la matriz: aquí se dejó en 0 porque la columna 'Quality Gate' de la matriz marca las reglas MAJOR como 'Bloquea'.",
    "max_permitidos": {
      "BLOCKER": 0,
      "CRITICAL": 0,
      "MAJOR": 0,
      "MINOR": null,
      "INFO": null
    },
    "bloquear_hallazgos_heuristicos": false,
    "_heuristicos": "Los hallazgos de confianza 'media' (reglas Parcial/semánticas) se reportan como 'Revisar' y no bloquean salvo que esto sea true.",
    "permitir_supresiones": true,
    "supresion_requiere_justificacion": true
  },
  "nomenclatura": {
    "_comentario": "Expresiones regulares (sin distinguir mayúsculas). Ajusta a la convención corporativa vigente.",
    "tabla": "^(TB|TBL|TMP|HIS|LOG|PAR|CAT)_[A-Z0-9_]+$",
    "columna": "^[A-Z][A-Z0-9_]*$",
    "primary_key": "^PK_[A-Z0-9_]+$",
    "foreign_key": "^FK_[A-Z0-9_]+$",
    "unique_key": "^(UK|UQ)_[A-Z0-9_]+$",
    "check": "^(CK|CHK)_[A-Z0-9_]+$",
    "indice": "^(IX|IDX|UX)_[A-Z0-9_]+$",
    "procedimiento": "^(PRC|SP|PR)_[A-Z0-9_]+$",
    "funcion": "^(FNC|FN|F)_[A-Z0-9_]+$",
    "paquete": "^(PKG|PK)_[A-Z0-9_]+$",
    "trigger": "^(TRG|TG)_[A-Z0-9_]+$",
    "vista": "^(VW|V)_[A-Z0-9_]+$",
    "secuencia": "^(SEQ|SQ)_[A-Z0-9_]+$",
    "variable_local": "^(V|L|LV)_[A-Z0-9_]+$",
    "variable_global": "^(G|GV)_[A-Z0-9_]+$",
    "parametro": "^(P|PI|PO|PIO|IN|OUT)_[A-Z0-9_]+$",
    "constante": "^(C|K|GC|CO)_[A-Z0-9_]+$",
    "cursor": "^(C|CUR|CR)_[A-Z0-9_]+$",
    "excepcion": "^(E|EX|EXC)_[A-Z0-9_]+$",
    "tipo": "^(T|TY|TYP)_[A-Z0-9_]+$",
    "nombres_ambiguos": [
      "DATA",
      "DATO",
      "DATOS",
      "TEMP",
      "TMP",
      "AUX",
      "VAR",
      "VALOR",
      "X",
      "Y",
      "Z",
      "RESULT",
      "RESULTADO",
      "INFO",
      "OBJ",
      "TEST",
      "PRUEBA",
      "FLAG",
      "CAMPO",
      "COSA"
    ]
  },
  "funciones_log": [
    "LOG",
    "REGISTRA",
    "REGISTRAR",
    "PRC_LOG",
    "PKG_LOG",
    "AUDIT",
    "LOGGER",
    "ERROR_LOG",
    "INSERTA_LOG",
    "GRABA_LOG"
  ],
  "oracle": {
    "_comentario": "Opcional. Si defines ORA_USER, ORA_PASSWORD y ORA_DSN como variables de entorno se ejecutan las reglas que requieren conexión (solo consultas de lectura).",
    "habilitado_si_hay_credenciales": true,
    "esquema": null
  },
  "dashboard_reglas": {
    "_comentario": "Dashboard publicado donde se editan reglas y política. La skill lo lee antes de cada análisis.",
    "url": "https://claude.ai/artifact/Lmh53NyPaL3EwCh8cuJVPe",
    "usar_antes_de_cada_analisis": true
  }
}